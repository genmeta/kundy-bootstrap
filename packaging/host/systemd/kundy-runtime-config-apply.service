[Unit]
Description=Apply the fixed Kundy runtime configuration to k3s
After=k3s.service kundy.service
Requires=kundy.service

[Service]
Type=oneshot
User=root
Group=root
Environment=HOME=/run/kundy
ExecStart=/usr/bin/kundy host runtime-config-apply
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run/kundy
